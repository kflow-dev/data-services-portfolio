   "metadata": {},
   "source": [
    "## 2. Content-Based Filtering\n",
    "\n",
    "Implement TF-IDF vectorization and cosine similarity for content-based recommendations."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "class ContentBasedRecommender:\n",
    "    \"\"\"Content-based news recommender using TF-IDF.\"\"\"\n",
    "    \n",
    "    def __init__(self, n_features=100):\n",
    "        self.n_features = n_features\n",
    "        self.vectorizer = TfidfVectorizer(\n",
    "            max_features=n_features,\n",
    "            stop_words='english',\n",
    "            ngram_range=(1, 2),\n",
    "            min_df=2\n",
    "        )\n",
    "        self.tfidf_matrix = None\n",
    "        self.article_titles = None\n",
    "        \n",
    "    def fit(self, df):\n",
    "        \"\"\"Fit the vectorizer on article titles.\"\"\"\n",
    "        self.article_titles = df['title'].values\n",
    "        self.tfidf_matrix = self.vectorizer.fit_transform(df['title'])\n",
    "        return self\n",
    "    \n",
    "    def recommend(self, article_id, n_recommendations=5, df=None):\n",
    "        \"\"\"Get similar articles for a given article.\"\"\"\n",
    "        if article_id not in df['article_id'].values:\n",
    "            raise ValueError(f\"Article {article_id} not found\")\n",
    "        \n",
    "        # Get index of the article\n",
    "        idx = df[df['article_id'] == article_id].index[0]\n",
    "        \n",
    "        # Compute cosine similarity\n",
    "        similarity = cosine_similarity(\n",
    "            self.tfidf_matrix[idx], \n",
    "            self.tfidf_matrix\n",
    "        )[0]\n",
    "        \n",
    "        # Get top N similar articles (excluding the article itself)\n",
    "        top_indices = similarity.argsort()[-(n_recommendations+1):-1][::-1]\n",
    "        \n",
    "        recommendations = []\n",
    "        for i in top_indices:\n",
    "            recommendations.append({\n",
    "                'article_id': df.iloc[i]['article_id'],\n",
    "                'title': df.iloc[i]['title'],\n",
    "                'category': df.iloc[i]['category'],\n",
    "                'similarity_score': round(similarity[i], 4)\n",
    "            })\n",
    "        \n",
    "        return recommendations\n",
    "    \n",
    "    def recommend_by_interests(self, interests, df, n_recommendations=10):\n",
    "        \"\"\"Recommend articles based on text interests.\"\"\"\n",
    "        # Transform interests to TF-IDF\n",
    "        interests_vec = self.vectorizer.transform([interests])\n",
    "        \n",
    "        # Compute similarity\n",
    "        similarity = cosine_similarity(interests_vec, self.tfidf_matrix)[0]\n",
    "        \n",
    "        # Get top N recommendations\n",
    "        top_indices = similarity.argsort()[-n_recommendations:][::-1]\n",
    "        \n",
    "        recommendations = []\n",
    "        for i in top_indices:\n",
    "            recommendations.append({\n",
    "                'article_id': df.iloc[i]['article_id'],\n",
    "                'title': df.iloc[i]['title'],\n",
    "                'category': df.iloc[i]['category'],\n",
    "                'similarity_score': round(similarity[i], 4)\n",
    "            })\n",
    "        \n",
    "        return recommendations"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
