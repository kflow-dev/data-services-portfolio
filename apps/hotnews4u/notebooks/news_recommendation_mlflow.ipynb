    "## 5. MLflow Experiment Tracking\n",
    "\n",
    "Track experiments, metrics, and model registry with MLflow."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "if MLFLOW_AVAILABLE:\n",
    "    # Set up MLflow tracking\n",
    "    mlflow.set_experiment(\"news_recommender\")\n",
    "    \n",
    "    with mlflow.start_run(run_name=\"content_based_baseline\"):\n",
    "        # Log parameters\n",
    "        mlflow.log_param(\"n_features\", 200)\n",
    "        mlflow.log_param(\"stop_words\", \"english\")\n",
    "        mlflow.log_param(\"ngram_range\", \"(1, 2)\")\n",
    "        \n",
    "        # Simulate evaluation metrics\n",
    "        # In production, compute actual metrics on test set\n",
    "        metrics = {\n",
    "            \"precision@5\": 0.72,\n",
    "            \"recall@5\": 0.65,\n",
    "            \"f1@5\": 0.68,\n",
    "            \"coverage\": 0.85\n",
    "        }\n",
    "        \n",
    "        for metric_name, metric_value in metrics.items():\n",
    "            mlflow.log_metric(metric_name, metric_value)\n",
    "        \n",
