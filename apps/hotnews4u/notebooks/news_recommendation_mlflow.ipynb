   "source": [
    "## 3. Collaborative Filtering with LightFM\n",
    "\n",
    "Implement hybrid collaborative filtering using LightFM for warm-start recommendations."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "class SyntheticUserInteractions:\n",
    "    \"\"\"Generate synthetic user-article interactions for collaborative filtering.\"\"\"\n",
    "    \n",
    "    @staticmethod\n",
    "    def generate(df, n_users=200, interaction_prob=0.3):\n",
    "        \"\"\"\n",
    "        Generate synthetic user-article interactions.\n",
    "        \n",
    "        Args:\n",
    "            df: Article dataframe\n",
    "            n_users: Number of synthetic users\n",
    "            interaction_prob: Probability of user interacting with article\n",
    "            \n",
    "        Returns:\n",
    "            DataFrame with user-article interactions\n",
    "        \"\"\"\n",
    "        np.random.seed(42)\n",
    "        n_articles = len(df)\n",
    "        \n",
    "        interactions = []\n",
    "        user_ids = [f\"U{str(i).zfill(4)}\" for i in range(1, n_users + 1)]\n",
    "        article_ids = df['article_id'].tolist()\n",
    "        \n",
    "        # Create user preference profiles based on categories\n",
    "        user_preferences = {}\n",
    "        for user in user_ids:\n",
    "            # Each user has preference for 1-3 categories\n",
    "            n_pref_cats = np.random.randint(1, 4)\n",
    "            prefs = np.random.choice(df['category'].unique(), size=n_pref_cats, replace=False)\n",
    "            user_preferences[user] = prefs\n",
    "        \n",
    "        # Generate interactions\n",
    "        for user in user_ids:\n",
    "            pref_cats = user_preferences[user]\n",
    "            \n",
    "            for idx, row in df.iterrows():\n",
    "                # Higher probability if article matches user preferences\n",
    "                if row['category'] in pref_cats:\n",
    "                    prob = interaction_prob * np.random.uniform(0.8, 1.2)\n",
    "                else:\n",
    "                    prob = interaction_prob * np.random.uniform(0.1, 0.3)\n",
    "                \n",
    "                if np.random.random() < prob:\n",
    "                    # Generate engagement score (1-5)\n",
    "                    engagement = min(5, max(1, int(row['engagement_score'] / 2)))\n",
    "                    interactions.append({\n",
    "                        'user_id': user,\n",
    "                        'article_id': row['article_id'],\n",
    "                        'engagement': engagement,\n",
    "                        'category': row['category']\n",
    "                    })\n",
    "        \n",
    "        return pd.DataFrame(interactions)\n",
    "\n",
    "\n",
    "def create_user_item_matrix(interactions_df):\n",
    "    \"\"\"Create sparse user-item matrix from interactions.\"\"\"\n",
    "    users = interactions_df['user_id'].unique()\n",
    "    articles = interactions_df['article_id'].unique()\n",
    "    \n",
    "    user_to_idx = {u: i for i, u in enumerate(users)}\n",
    "    item_to_idx = {a: i for i, a in enumerate(articles)}\n",
    "    \n",
    "    n_users = len(users)\n",
    "    n_items = len(articles)\n",
    "    \n",
    "    # Create dense matrix for demo (use sparse in production)\n",
    "    matrix = np.zeros((n_users, n_items))\n",
    "    \n",
    "    for _, row in interactions_df.iterrows():\n",
    "        u_idx = user_to_idx[row['user_id']]\n",
    "        i_idx = item_to_idx[row['article_id']]\n",
    "        matrix[u_idx, i_idx] = row['engagement']\n",
    "    \n",
    "    return matrix, user_to_idx, item_to_idx, users, articles"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Generate synthetic interactions\n",
    "print(\"Generating synthetic user-article interactions...\")\n",
    "interactions = SyntheticUserInteractions.generate(df, n_users=200, interaction_prob=0.25)\n",
    "print(f\"Generated {len(interactions)} interactions from {interactions['user_id'].nunique()} users\")\n",
    "\n",
    "# Show interaction distribution\n",
    "print(\"\\nInteraction distribution:\")\n",
    "print(interactions['engagement'].value_counts().sort_index())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "if LIGHTFM_AVAILABLE:\n",
    "    # Create user-item matrix\n",
    "    user_item_matrix, user_to_idx, item_to_idx, users, articles = create_user_item_matrix(interactions)\n",
    "    \n",
    "    # Split into train/test\n",
    "    train_matrix, test_matrix = train_test_split(\n",
    "        user_item_matrix.flatten(), \n",
    "        test_size=0.2, \n",
    "        random_state=42\n",
    "    )\n",
    "    train_matrix = train_matrix.reshape(len(users), -1)\n",
    "    \n",
    "    print(f\"Training matrix shape: {train_matrix.shape}\")\n",
    "    print(f\"Non-zero entries: {np.count_nonzero(train_matrix)}\")\n",
    "\n",
    "    # Initialize and train LightFM model\n",
    "    print(\"\\nTraining LightFM model...\")\n",
    "    model = LightFM(loss='warp', \n",
    "                   n_components=50, \n",
    "                   learning_rate=0.05,\n",
    "                   random_state=42)\n",
    "    \n",
    "    # Train model\n",
    "    model.fit(train_matrix, epochs=20, num_threads=4)\n",
    "    \n",
    "    print(\"Model trained successfully!\")\n",
    "else:\n",
    "    print(\"LightFM not available - skipping collaborative filtering training\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Hybrid Recommendation\n",
    "\n",
    "Combine content-based and collaborative filtering for better recommendations."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "class HybridRecommender:\n",
    "    \"\"\"Hybrid recommender combining content-based and collaborative filtering.\"\"\"\n",
    "    \n",
    "    def __init__(self, content_weight=0.3, collab_weight=0.7):\n",
    "        self.content_weight = content_weight\n",
    "        self.collab_weight = collab_weight\n",
    "        self.content_recommender = None\n",
    "        self.collab_model = None\n",
    "        self.df = None\n",
    "        \n",
    "    def fit(self, content_rec, collab_model=None, df=None):\n",
    "        \"\"\"Fit hybrid recommender with pre-trained models.\"\"\"\n",
    "        self.content_recommender = content_rec\n",
    "        self.collab_model = collab_model\n",
    "        self.df = df\n",
    "        return self\n",
    "    \n",
    "    def recommend(self, article_id, n_recommendations=5):\n",
    "        \"\"\"Generate hybrid recommendations.\"\"\"\n",
    "        # Get content-based recommendations\n",
    "        content_recs = self.content_recommender.recommend(article_id, n_recommendations, self.df)\n",
    "        \n",
    "        # Get collaborative filtering recommendations\n",
    "        if self.collab_model is not None and LIGHTFM_AVAILABLE:\n",
    "            collab_recs = self._get_collab_recommendations(article_id, n_recommendations)\n",
    "        else:\n",
    "            collab_recs = []\n",
    "        \n",
    "        # Combine recommendations\n",
    "        combined = self._combine_recommendations(content_recs, collab_recs, n_recommendations)\n",
    "        \n",
    "        return combined\n",
    "    \n",
    "    def _get_collab_recommendations(self, article_id, n_recommendations):\n",
    "        \"\"\"Get collaborative filtering recommendations.\"\"\"\n",
    "        if article_id not in self.df['article_id'].values:\n",
    "            return []\n",
    "        \n",
    "        # Get article index\n",
    "        idx = self.df[self.df['article_id'] == article_id].index[0]\n",
    "        \n",
    "        # Get similar articles from user-item matrix\n",
    "        similarity = cosine_similarity(\n",
    "            user_item_matrix[idx].reshape(1, -1),\n",
    "            user_item_matrix\n",
    "        )[0]\n",
    "        \n",
    "        top_indices = similarity.argsort()[-(n_recommendations+1):-1][::-1]\n",
    "        \n",
    "        recommendations = []\n",
    "        for i in top_indices:\n",
    "            article_idx = self.df.index[idx] if hasattr(self, 'df') else i\n",
    "            if article_idx < len(self.df):\n",
    "                recommendations.append({\n",
    "                    'article_id': self.df.iloc[article_idx]['article_id'],\n",
    "                    'title': self.df.iloc[article_idx]['title'],\n",
    "                    'category': self.df.iloc[article_idx]['category'],\n",
    "                    'similarity_score': round(similarity[i], 4)\n",
    "                })\n",
    "        \n",
    "        return recommendations\n",
    "    \n",
    "    def _combine_recommendations(self, content_recs, collab_recs, n_recommendations):\n",
    "        \"\"\"Combine content-based and collaborative filtering recommendations.\"\"\"\n",
    "        # Create a dictionary to merge scores\n",
    "        merged_scores = {}\n",
    "        \n",
    "        for rec in content_recs:\n",
    "            merged_scores[rec['article_id']] = {\n",
    "                'title': rec['title'],\n",
    "                'category': rec['category'],\n",
    "                'content_score': rec['similarity_score'],\n",
    "                'collab_score': 0\n",
    "            }\n",
    "        \n",
    "        for rec in collab_recs:\n",
    "            if rec['article_id'] in merged_scores:\n",
    "                merged_scores[rec['article_id']]['collab_score'] = rec['similarity_score']\n",
    "            else:\n",
    "                merged_scores[rec['article_id']] = {\n",
    "                    'title': rec['title'],\n",
    "                    'category': rec['category'],\n",
    "                    'content_score': 0,\n",
    "                    'collab_score': rec['similarity_score']\n",
    "                }\n",
    "        \n",
    "        # Calculate weighted combined score\n",
    "        for article_id, scores in merged_scores.items():\n",
    "            scores['combined_score'] = (\n",
    "                self.content_weight * scores['content_score'] +\n",
    "                self.collab_weight * scores['collab_score']\n",
    "            )\n",
    "        \n",
    "        # Sort by combined score\n",
    "        sorted_recs = sorted(\n",
    "            merged_scores.values(),\n",
    "            key=lambda x: x['combined_score'],\n",
    "            reverse=True\n",
    "        )\n",
    "        \n",
    "        # Return top N\n",
    "        for rec in sorted_recs:\n",
    "            rec['similarity_score'] = rec.pop('combined_score')\n",
    "        \n",
    "        return sorted_recs[:n_recommendations]"
   ]
  },
