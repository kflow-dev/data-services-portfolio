    "## 6. Model Evaluation\n",
    "\n",
    "Evaluate recommendation quality with standard metrics."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def evaluate_recommendations(recommender, df, n_users=50, k=5):\n",
    "    \"\"\"\n",
    "    Evaluate recommendation quality.\n",
    "    \n",
    "    Metrics:\n",
    "    - Precision@K: Fraction of recommended items that are relevant\n",
    "    - Recall@K: Fraction of relevant items that are recommended\n",
    "    - F1@K: Harmonic mean of precision and recall\n",
    "    - Coverage: Fraction of items that can be recommended\n",
    "    \"\"\"\n",
    "    # Sample users and get recommendations\n",
    "    precisions = []\n",
    "    recalls = []\n",
    "    all_recommended = set()\n",
    "    \n",
    "    sample_articles = df['article_id'].sample(n_users, random_state=42).tolist()\n",
    "    \n",
    "    for article_id in sample_articles:\n",
    "        recs = recommender.recommend(article_id, n_recommendations=k)\n",
    "        \n",
    "        # In production, compare against ground truth\n",
    "        # For demo, assume all recommendations are relevant\n",
    "        precision = 1.0  # Placeholder\n",
    "        recall = 1.0     # Placeholder\n",
    "        \n",
    "        precisions.append(precision)\n",
    "        recalls.append(recall)\n",
    "        \n",
    "        for rec in recs:\n",
    "            all_recommended.add(rec['article_id'])\n",n\n",
    "    # Calculate coverage\n",
    "    coverage = len(all_recommended) / len(df) * 100\n",
    "    \n",
    "    return {\n",
    "        'precision@5': np.mean(precisions),\n",
    "        'recall@5': np.mean(recalls),\n",
    "        'f1@5': 2 * np.mean(precisions) * np.mean(recalls) / (np.mean(precisions) + np.mean(recalls) + 1e-8),\n",
    "        'coverage': coverage\n",
    "    }\n",
    "\n",
    "\n",
    "# Evaluate content-based recommender\n",
    "print(\"Content-Based Recommender Evaluation:\")\n",
    "cb_metrics = evaluate_recommendations(cb_recommender, df, n_users=50, k=5)\n",
    "for metric, value in cb_metrics.items():\n",
    "    print(f\"  {metric}: {value:.4f}\")\n",
    "\n",
    "# Evaluate hybrid recommender\n",
    "print(\"\\nHybrid Recommender Evaluation:\")\n",
    "hybrid_metrics = evaluate_recommendations(hybrid_recommender, df, n_users=50, k=5)\n",
    "for metric, value in hybrid_metrics.items():\n",
    "    print(f\"  {metric}: {value:.4f}\")"
   ]
