   "source": [
    "# Add conformal prediction intervals\n",
    "print(\"\\nAdding prediction intervals...\")\n",
    "ensemble_forecasts = conformal.get_intervals(ensemble_forecasts)\n",
    "\n",
    "# Reconcile\n",
    "ensemble_reconciled = minimize_reconciliation_error(ensemble_forecasts)\n",
    "\n",
    "# Summary statistics\n",
    "print(\"\\n=== Forecast Summary ===\")\n",
    "print(f\"Total SKUs forecasted: {ensemble_reconciled['sku'].nunique()}\")\n",
    "print(f\"Forecast horizon: {horizon} weeks\")\n",
    "print(f\"Total forecasted demand: {ensemble_reconciled['forecast'].sum():,.0f} units\")\n",
    "print(f\"Avg prediction interval width (80%): {(ensemble_reconciled['upper_80'] - ensemble_reconciled['lower_80']).mean():,.0f} units\")"
