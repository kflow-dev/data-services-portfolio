    "### 5.4 Ensemble Forecaster"
   ]
  },
  {
   "cell_type": "code",
    "execution_count": null,
    "metadata": {},
    "outputs": [],
    "source": [
    "class EnsembleForecaster:\n",
    "    \"\"\"\n",
    "    Ensemble blending of multiple models.\n",
    "    \n",
    "    Uses weighted averaging (blending) to combine predictions from:\n",
    "    - Gradient Boosting\n",
    "    - LSTM\n",
    "    - DeepAR\n",
    "    - N-BEATS (conceptual)\n",
    "    - TFT (conceptual)\n",
    "    \"\"\"\n",
    "    \n",
    "    def __init__(self, weights: Dict[str, float] = None):\n",
    "        self.weights = weights or {\"gb\": 0.2, \"lstm\": 0.2, \"deepar\": 0.2, \"nbeats\": 0.2, \"tft\": 0.2}\n",
    "        self.forecasters = {\n",
    "            \"gb\": HierarchicalGBForecaster(),\n",
    "            \"lstm\": LSTMForecaster(),\n",
    "            \"deepar\": DeepARForecaster(),\n",
    "        }\n",
    "        \n",
    "    def fit(self, df: pd.DataFrame):\n",
    "        \"\"\"Fit all base models.\"\"\"\n",
    "        for name, forecaster in self.forecasters.items():\n",
    "            print(f\"Training {name}...\")\n",
    "            if name == \"gb\":\n",
    "                forecaster.fit(df)\n",
    "            else:\n",
    "                forecaster.fit(df)\n",
    "            print(f\"  -> Trained {len(forecaster.models)} models\")\n",
    "            \n",
    "    def predict(self, df: pd.DataFrame, horizon: int = 12) -> pd.DataFrame:\n",
    "        \"\"\"Generate ensemble forecast using weighted blending.\"\"\"\n",
    "        all_predictions = {}\n",
    "        \n",
    "        for name, forecaster in self.forecasters.items():\n",
    "            preds = forecaster.predict(df, horizon)\n",
    "            preds[\"model\"] = name\n",
    "            all_predictions[name] = preds\n",
    "        \n",
    "        # Blend predictions\n",
    "        if not all_predictions:\n",
    "            return pd.DataFrame()\n",
    "        \n",
    "        # Get common columns\n",
    "        base_cols = [\"week\", \"country\", \"shop\", \"product_category\", \"product_group\", \"sku\", \"sku_size\"]\n",
    "        \n",
    "        # Start with first prediction\n",
    "        ensemble_preds = all_predictions[list(all_predictions.keys())[0]][base_cols].copy()\n",
    "        ensemble_preds[\"forecast\"] = 0\n",
    "        \n",
    "        # Weighted sum\n",
    "        for name, preds in all_predictions.items():\n",
    "            if name in self.weights:\n",
    "                ensemble_preds[\"forecast\"] += preds[\"forecast\"].values * self.weights[name]\n",
    "        \n",
    "        ensemble_preds[\"model\"] = \"ensemble\"\n",
    "        \n",
    "        return ensemble_preds\n",
    "\n",
    "# Train ensemble model\n",
    "print(\"\\nTraining Ensemble model...\")\n",
    "ensemble_forecaster = EnsembleForecaster(weights={\"gb\": 0.3, \"lstm\": 0.25, \"deepar\": 0.25, \"nbeats\": 0.1, \"tft\": 0.1})\n",
    "ensemble_forecaster.fit(df_featured)\n",
    "print(f\"Ensemble trained with {len(ensemble_forecaster.forecasters)} base models\")"
   ]
  },
