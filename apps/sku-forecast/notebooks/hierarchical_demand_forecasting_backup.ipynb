   "source": [
    "## 5. Model Implementations"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 5.1 Gradient Boosting Regressor (Baseline)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "class HierarchicalGBForecaster:\n",
    "    \"\"\"Gradient Boosting Regressor with hierarchical features.\"\"\"\n",
    "    \n",
    "    def __init__(self, n_estimators: int = 100, max_depth: int = 5, learning_rate: float = 0.1):\n",
    "        self.n_estimators = n_estimators\n",
    "        self.max_depth = max_depth\n",
    "        self.learning_rate = learning_rate\n",
    "        self.models: Dict[str, GradientBoostingRegressor] = {}\n",
    "        self.scaler = StandardScaler()\n",
    "        \n",
    "    def fit(self, df: pd.DataFrame, target_col: str = \"quantity_sold\"):\n",
    "        \"\"\"Train model at each SKU level.\"\"\"\n",
    "        unique_skus = df[\"sku\"].unique()\n",
    "        \n",
    "        feature_cols = [\n",
    "            \"week\", \"day_of_year\", \"week_of_year\", \"day_of_week\",\n",
    "            \"is_holiday\", \"is_back_to_school\", \"is_black_friday\", \"is_christmas\",\n",
    "            \"week_sin\", \"week_cos\", \"day_sin\", \"day_cos\", \"dow_sin\", \"dow_cos\",\n",
    "            \"lag_1\", \"lag_4\", \"lag_8\", \"lag_12\", \"lag_52\",\n",
    "            \"rolling_mean_4\", \"rolling_std_4\", \"yoy_lag_52\",\n",
    "            \"discount_pct\", \"base_price\",\n",
    "            \"country_mean\", \"shop_mean\", \"product_category_mean\", \"product_group_mean\",\n",
    "            \"country_sum\", \"shop_sum\", \"product_category_sum\", \"product_group_sum\",\n",
    "        ]\n",
    "        \n",
    "        for sku in unique_skus:\n",
    "            df_sku = df[df[\"sku\"] == sku].copy()\n",
    "            df_sku = df_sku.dropna(subset=feature_cols + [target_col])\n",
    "            \n",
    "            if len(df_sku) < 20:\n",
    "                continue\n",
    "            \n",
    "            X = df_sku[feature_cols].values\n",
    "            y = df_sku[target_col].values\n",
    "            X_scaled = self.scaler.fit_transform(X)\n",
    "            \n",
    "            model = GradientBoostingRegressor(\n",
    "                n_estimators=self.n_estimators,\n",
    "                max_depth=self.max_depth,\n",
    "                learning_rate=self.learning_rate,\n",
    "                random_state=42\n",
    "            )\n",
    "            model.fit(X_scaled, y)\n",
    "            self.models[sku] = model\n",
    "            \n",
    "    def predict(self, df: pd.DataFrame, horizon: int = 12) -> pd.DataFrame:\n",
    "        \"\"\"Generate forecasts for horizon weeks.\"\"\"\n",
    "        predictions = []\n",
    "        \n",
    "        for sku in self.models.keys():\n",
    "            df_sku = df[df[\"sku\"] == sku]\n",
    "            last_week = int(df_sku[\"week\"].max())\n",
    "            last_row = df_sku.iloc[-1]\n",
    "            \n",
    "            for week in range(last_week + 1, last_week + horizon + 1):\n",
    "                for size in df_sku[\"sku_size\"].unique():\n",
    "                    features = {\n",
    "                        \"week\": week,\n",
    "                        \"day_of_year\": (week * 7) % 365,\n",
    "                        \"week_of_year\": week % 52,\n",
    "                        \"day_of_week\": (week * 7) % 7,\n",
    "                        \"is_holiday\": week in [8, 24, 35, 48, 52, 56, 71, 80, 88, 96],\n",
    "                        \"is_back_to_school\": week in [17, 18, 70, 71],\n",
    "                        \"is_black_friday\": week in [48, 100],\n",
    "                        \"is_christmas\": week in [50, 51, 52, 4],\n",
    "                        \"week_sin\": np.sin(2 * np.pi * (week % 52) / 52),\n",
    "                        \"week_cos\": np.cos(2 * np.pi * (week % 52) / 52),\n",
    "                        \"day_sin\": np.sin(2 * np.pi * ((week * 7) % 365) / 365),\n",
    "                        \"day_cos\": np.cos(2 * np.pi * ((week * 7) % 365) / 365),\n",
    "                        \"dow_sin\": np.sin(2 * np.pi * ((week * 7) % 7) / 7),\n",
    "                        \"dow_cos\": np.cos(2 * np.pi * ((week * 7) % 7) / 7),\n",
    "                        \"lag_1\": last_row[\"quantity_sold\"],\n",
    "                        \"lag_4\": last_row[\"quantity_sold\"] * 0.95,\n",
    "                        \"lag_8\": last_row[\"quantity_sold\"] * 0.90,\n",
    "                        \"lag_12\": last_row[\"quantity_sold\"] * 0.85,\n",
    "                        \"lag_52\": last_row[\"quantity_sold\"] * 1.02,\n",
    "                        \"rolling_mean_4\": last_row[\"quantity_sold\"] * 0.98,\n",
    "                        \"rolling_std_4\": 20,\n",
    "                        \"yoy_lag_52\": last_row[\"quantity_sold\"] * 1.02,\n",
    "                        \"discount_pct\": np.random.choice([0, 5, 10], p=[0.5, 0.3, 0.2]),\n",
    "                        \"base_price\": last_row[\"base_price\"],\n",
    "                        \"country_mean\": last_row[\"country_mean\"],\n",
    "                        \"shop_mean\": last_row[\"shop_mean\"],\n",
    "                        \"product_category_mean\": last_row[\"product_category_mean\"],\n",
    "                        \"product_group_mean\": last_row[\"product_group_mean\"],\n",
    "                        \"country_sum\": last_row[\"country_sum\"],\n",
    "                        \"shop_sum\": last_row[\"shop_sum\"],\n",
    "                        \"product_category_sum\": last_row[\"product_category_sum\"],\n",
    "                        \"product_group_sum\": last_row[\"product_group_sum\"],\n",
    "                    }\n",
    "                    \n",
    "                    X = pd.DataFrame([features])\n",
    "                    X_scaled = self.scaler.transform(X)\n",
    "                    pred = self.models[sku].predict(X_scaled)[0]\n",
    "                    \n",
    "                    predictions.append({\n",
    "                        \"week\": week,\n",
    "                        \"country\": last_row[\"country\"],\n",
    "                        \"shop\": last_row[\"shop\"],\n",
    "                        \"product_category\": last_row[\"product_category\"],\n",
    "                        \"product_group\": last_row[\"product_group\"],\n",
    "                        \"sku\": sku,\n",
    "                        \"sku_size\": size,\n",
    "                        \"forecast\": max(0, pred),\n",
    "                        \"model\": \"gradient_boosting\",\n",
    "                    })\n",
    "        \n",
    "        return pd.DataFrame(predictions)\n",
    "\n",
    "# Train GB model\n",
    "print(\"Training Gradient Boosting model...\")\n",
    "gb_forecaster = HierarchicalGBForecaster(n_estimators=100, max_depth=5, learning_rate=0.1)\n",
    "gb_forecaster.fit(df_featured)\n",
    "print(f\"Trained {len(gb_forecaster.models)} SKU models\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 5.2 LSTM-like Forecaster"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "class LSTMForecaster:\n",
    "    \"\"\"\n",
    "    Simplified LSTM-like forecasting using temporal pattern learning.\n",
    "    \n",
    "    In a production environment, this would use PyTorch/LSTM:\n",
    "    - torch.nn.LSTM with sequence modeling\n",
    "    - Multi-variate input features\n",
    "    - Dropout for regularization\n",
    "    \"\"\"\n",
    "    \n",
    "    def __init__(self, units: int = 64, epochs: int = 50, batch_size: int = 32):\n",
    "        self.units = units\n",
    "        self.epochs = epochs\n",
    "        self.batch_size = batch_size\n",
    "        self.models = {}\n",
    "        \n",
    "    def fit(self, df: pd.DataFrame, target_col: str = \"quantity_sold\", sequence_length: int = 52):\n",
    "        \"\"\"Fit LSTM model using temporal patterns.\"\"\"\n",
    "        unique_skus = df[\"sku\"].unique()\n",
    "        \n",
    "        for sku in unique_skus:\n",
    "            df_sku = df[df[\"sku\"] == sku].sort_values(\"week\")\n",
    "            \n",
    "            if len(df_sku) < sequence_length * 2:\n",
    "                continue\n",
    "            \n",
    "            target = df_sku[target_col].values\n",
    "            last_sequence = target[-sequence_length:]\n",
    "            \n",
    "            # Store learned patterns (simulating LSTM internal states)\n",
    "            self.models[sku] = {\n",
    "                \"last_sequence\": last_sequence,\n",
    "                \"mean\": np.mean(last_sequence),\n",
    "                \"std\": np.std(last_sequence),\n",
    "                \"trend\": np.polyfit(range(sequence_length), last_sequence, 1)[0],\n",
    "                \"seasonality\": [\n",
    "                    np.mean(last_sequence[i::sequence_length])\n",
    "                    for i in range(min(sequence_length, len(last_sequence)))\n",
    "                ][:52],\n",
    "            }\n",
    "            \n",
    "    def predict(self, df: pd.DataFrame, horizon: int = 12) -> pd.DataFrame:\n",
    "        \"\"\"Generate forecasts using learned patterns.\"\"\"\n",
    "        predictions = []\n",
    "        \n",
    "        for sku, model in self.models.items():\n",
    "            df_sku = df[df[\"sku\"] == sku]\n",
    "            \n",
    "            if df_sku.empty:\n",
    "                continue\n",
    "            \n",
    "            last_row = df_sku.iloc[-1]\n",
    "            last_week = int(df_sku[\"week\"].max())\n",
    "            \n",
    "            for week in range(last_week + 1, last_week + horizon + 1):\n",
    "                for size in df_sku[\"sku_size\"].unique():\n",
    "                    # Pattern-based forecast (simulating LSTM prediction)\n",
    "                    weeks_ahead = week - last_week\n",
    "                    trend_component = model[\"trend\"] * weeks_ahead\n",
    "                    seasonal_idx = (week - 1) % 52\n",
    "                    seasonal_component = model[\"seasonality\"][seasonal_idx] if seasonal_idx < len(model[\"seasonality\"]) else model[\"mean\"]\n",
    "                    noise = np.random.normal(0, model[\"std\"] * 0.1)\n",
    "                    \n",
    "                    forecast = model[\"mean\"] + trend_component + seasonal_component + noise\n",
    "                    \n",
    "                    predictions.append({\n",
    "                        \"week\": week,\n",
    "                        \"country\": last_row[\"country\"],\n",
    "                        \"shop\": last_row[\"shop\"],\n",
    "                        \"product_category\": last_row[\"product_category\"],\n",
    "                        \"product_group\": last_row[\"product_group\"],\n",
    "                        \"sku\": sku,\n",
    "                        \"sku_size\": size,\n",
    "                        \"forecast\": max(0, forecast),\n",
    "                        \"model\": \"lstm\",\n",
    "                    })\n",
    "        \n",
    "        return pd.DataFrame(predictions)\n",
    "\n",
    "# Train LSTM model\n",
    "print(\"Training LSTM model...\")\n",
    "lstm_forecaster = LSTMForecaster(units=64, epochs=50, batch_size=32)\n",
    "lstm_forecaster.fit(df_featured)\n",
    "print(f\"Trained {len(lstm_forecaster.models)} SKU models\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 5.3 DeepAR Forecaster"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "class DeepARForecaster:\n",
    "    \"\"\"\n",
    "    DeepAR-style probabilistic forecasting.\n",
    "    \n",
    "    DeepAR (Deep Autoregressive) is a probabilistic forecasting model that:\n",
    "    - Models the full probability distribution of future values\n",
    "    - Uses RNN/LSTM to learn temporal dependencies\n",
    "    - Provides prediction intervals naturally through sampling\n",
    "    \n",
    "    Production implementation would use GluonTS or NeuralForecast.\n",
    "    \"\"\"\n",
    "    \n",
    "    def __init__(self, epochs: int = 50, lr: float = 0.001, batch_size: int = 32):\n",
    "        self.epochs = epochs\n",
    "        self.lr = lr\n",
    "        self.batch_size = batch_size\n",
    "        self.models = {}\n",
    "        \n",
    "    def fit(self, df: pd.DataFrame, target_col: str = \"quantity_sold\", sequence_length: int = 52):\n",
    "        \"\"\"Fit DeepAR-style model.\"\"\"\n",
    "        unique_skus = df[\"sku\"].unique()\n",
    "        \n",
    "        for sku in unique_skus:\n",
    "            df_sku = df[df[\"sku\"] == sku].sort_values(\"week\")\n",
    "            \n",
    "            if len(df_sku) < sequence_length:\n",
    "                continue\n",
    "            \n",
    "            target = df_sku[target_col].values\n",
    "            recent_target = target[-sequence_length:]\n",
    "            \n",
    "            # Learn distribution parameters (simulating DeepAR)\n",
    "            self.models[sku] = {\n",
    "                \"observations\": recent_target,\n",
    "                \"mean\": np.mean(recent_target),\n",
    "                \"variance\": np.var(recent_target),\n",
    "                \"std\": np.sqrt(np.var(recent_target)),\n",
    "                \"seasonal_pattern\": [\n",
    "                    np.mean(recent_target[i::sequence_length])\n",
    "                    for i in range(sequence_length)\n",
    "                ][:52],\n",
    "            }\n",
    "            \n",
    "    def predict(self, df: pd.DataFrame, horizon: int = 12) -> pd.DataFrame:\n",
    "        \"\"\"Generate probabilistic forecasts.\"\"\"\n",
    "        predictions = []\n",
    "        \n",
    "        for sku, model in self.models.items():\n",
    "            df_sku = df[df[\"sku\"] == sku]\n",
    "            \n",
    "            if df_sku.empty:\n",
    "                continue\n",
    "            \n",
    "            last_row = df_sku.iloc[-1]\n",
    "            last_week = int(df_sku[\"week\"].max())\n",
    "            \n",
    "            for week in range(last_week + 1, last_week + horizon + 1):\n",
    "                for size in df_sku[\"sku_size\"].unique():\n",
    "                    # Sample from learned distribution\n",
    "                    seasonal_idx = (week - 1) % 52\n",
    "                    seasonal_mean = model[\"seasonal_pattern\"][seasonal_idx] if seasonal_idx < len(model[\"seasonal_pattern\"]) else model[\"mean\"]\n",
    "                    \n",
    "                    forecast = np.random.normal(seasonal_mean, model[\"std\"])\n",
    "                    \n",
    "                    predictions.append({\n",
    "                        \"week\": week,\n",
    "                        \"country\": last_row[\"country\"],\n",
    "                        \"shop\": last_row[\"shop\"],\n",
    "                        \"product_category\": last_row[\"product_category\"],\n",
    "                        \"product_group\": last_row[\"product_group\"],\n",
    "                        \"sku\": sku,\n",
    "                        \"sku_size\": size,\n",
    "                        \"forecast\": max(0, forecast),\n",
    "                        \"model\": \"deepar\",\n",
    "                    })\n",
    "        \n",
    "        return pd.DataFrame(predictions)\n",
    "\n",
    "# Train DeepAR model\n",
    "print(\"Training DeepAR model...\")\n",
    "deepar_forecaster = DeepARForecaster(epochs=50, lr=0.001, batch_size=32)\n",
    "deepar_forecaster.fit(df_featured)\n",
    "print(f\"Trained {len(deepar_forecaster.models)} SKU models\")"
   ]
