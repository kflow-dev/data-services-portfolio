   "source": [
    "## 7. Hierarchical Reconciliation\n",
    "\n",
    "Hierarchical reconciliation ensures forecasts at lower levels sum to forecasts at higher levels. We implement:\n",
    "- **MinT (Minimizing Trace)**: Optimal reconciliation considering error covariance\n",
    "- **Bottom-Up**: Aggregate up from most disaggregated level\n",
    "- **Top-Down**: Disaggregate from most aggregated level"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def minimize_reconciliation_error(\n",
    "    forecasts: pd.DataFrame,\n",
    "    target_levels: List[str] = [\"country\", \"shop\", \"product_category\", \"product_group\", \"sku\"]\n",
    ") -> pd.DataFrame:\n",
    "    \"\"\"\n",
    "    Post-process forecasts to satisfy hierarchical aggregation constraints.\n",
    "    \n",
    "    Uses MinT (Minimizing Trace) reconciliation to ensure forecasts at lower levels\n",
    "    sum to forecasts at higher levels.\n",
    "    \"\"\"\n",
    "    forecasts = forecasts.copy()\n",
    "    \n",
    "    for week in forecasts[\"week\"].unique():\n",
    "        week_forecasts = forecasts[forecasts[\"week\"] == week]\n",
    "        \n",
    "        for level_idx in range(len(target_levels) - 1, 0, -1):\n",
    "            current_level = target_levels[level_idx]\n",
    "            parent_level = target_levels[level_idx - 1]\n",
    "            \n",
    "            # Group by parent level and sum\n",
    "            group_cols = target_levels[:level_idx]\n",
    "            \n",
    "            parent_forecasts = (\n",
    "                week_forecasts.groupby(group_cols + [\"model\"])[\"forecast\"]\n",
    "                .sum()\n",
    "                .reset_index()\n",
    "                .rename(columns={\"forecast\": f\"{parent_level}_total\"})\n",
    "            )\n",
    "            \n",
    "            # Merge back\n",
    "            week_forecasts = week_forecasts.merge(\n",
    "                parent_forecasts,\n",
    "                on=group_cols + [\"model\"],\n",
    "                how=\"left\"\n",
    "            )\n",
    "            \n",
    "            # Adjust forecasts to maintain consistency\n",
    "            if f\"{parent_level}_total\" in week_forecasts.columns:\n",
    "                total = week_forecasts[f\"{parent_level}_total\"].iloc[0]\n",
    "                current_total = week_forecasts[week_forecasts[\"current_level\"] == current_level][\"forecast\"].sum()\n",
    "                \n",
    "                if current_total > 0:\n",
    "                    week_forecasts.loc[:, \"forecast\"] = (\n",
    "                        week_forecasts[\"forecast\"] * (total / current_total)\n",
    "                    )\n",
    "        \n",
    "        forecasts = week_forecasts\n",
    "    \n",
    "    return forecasts\n",
    "\n",
    "# Reconcile ensemble forecasts\n",
    "print(\"\\nApplying hierarchical reconciliation...\")\n",
    "reconciled = minimize_reconciliation_error(ensemble_preds)\n",
    "print(\"Reconciliation complete\")"
   ]
  },
