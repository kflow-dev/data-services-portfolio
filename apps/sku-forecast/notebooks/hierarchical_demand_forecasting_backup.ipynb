   "source": [
    "## 6. Conformal Prediction for Uncertainty Quantification"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
    "outputs": [],
    "source": [
    "class ConformalUncertainty:\n",
    "    \"\"\"\n",
    "    Conformal prediction for uncertainty quantification.\n",
    "    \n",
    "    Conformal prediction provides statistically valid prediction intervals\n",
    "    that guarantee coverage probability (e.g., 80% of true values fall within CI).\n",
    "    \n",
    "    Method:\n",
    "    1. Calibrate on held-out data to compute non-conformity scores\n",
    "    2. Compute quantile of scores for desired confidence level\n",
    "    3. Add/subtract quantile from forecast for prediction intervals\n",
    "    \"\"\"\n",
    "    \n",
    "    def __init__(self, confidence_level: float = 0.80):\n",
    "        self.confidence_level = confidence_level\n",
    "        self.quantile = None\n",
    "        \n",
    "    def calibrate(self, y_true: np.ndarray, y_pred: np.ndarray):\n",
    "        \"\"\"Calibrate conformal predictor on residuals.\"\"\"\n",
    "        residuals = np.abs(y_true - y_pred)\n",
    "        self.quantile = np.quantile(residuals, self.confidence_level)\n",
    "        print(f\"  -> Calibrated quantile: {self.quantile:.2f}\")\n",
    "        \n",
    "    def get_intervals(self, forecast: pd.DataFrame) -> pd.DataFrame:\n",
    "        \"\"\"Add conformal prediction intervals to forecasts.\"\"\"\n",
    "        forecast = forecast.copy()\n",
    "        \n",
    "        width = self.quantile * 2\n",
    "        \n",
    "        # 80% prediction interval (using 0.84 scaling factor for normal approx)\n",
    "        forecast[\"lower_80\"] = forecast[\"forecast\"] - self.quantile * 0.84\n",
    "        forecast[\"upper_80\"] = forecast[\"forecast\"] + self.quantile * 0.84\n",
    "        \n",
    "        # 95% prediction interval\n",
    "        forecast[\"lower_95\"] = forecast[\"forecast\"] - self.quantile * 1.96\n",
    "        forecast[\"upper_95\"] = forecast[\"forecast\"] + self.quantile * 1.96\n",
    "        \n",
    "        # Ensure non-negative\n",
    "        forecast[\"lower_80\"] = forecast[\"lower_80\"].clip(lower=0)\n",
    "        forecast[\"lower_95\"] = forecast[\"lower_95\"].clip(lower=0)\n",
    "        \n",
    "        return forecast\n",
    "\n",
    "# Calibrate conformal predictor\n",
    "print(\"\\nCalibrating conformal predictor...\")\n",
    "\n",
    "# Use last year of data for calibration\n",
    "last_year = df_featured[df_featured[\"week\"] > df_featured[\"week\"].max() - 52]\n",
    "\n",
    "# Simple calibration using GB predictions\n",
    "conformal = ConformalUncertainty(confidence_level=0.80)\n",
    "\n",
    "# Mock calibration (in production, use actual residuals)\n",
    "np.random.seed(42)\n",
    "mock_residuals = np.abs(np.random.normal(0, 15, len(last_year)))\n",
    "conformal.residuals = mock_residuals\n",
    "conformal.quantile = np.quantile(mock_residuals, 0.80)\n",
    "\n",
    "print(f\"Conformal quantile (80%): {conformal.quantile:.2f}\")"
   ]
  },
