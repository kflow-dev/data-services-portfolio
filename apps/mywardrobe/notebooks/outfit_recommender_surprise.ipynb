   "source": [
    "# Outfit Recommendation with Surprise Library\n",
    "\n",
    "## Overview\n",
    "\n",
    "This notebook demonstrates outfit recommendation using collaborative filtering with the **Surprise** library - a pure Python library built specifically for recommender systems.\n",
    "\n",
    "## Key Features\n",
    "- **Surprise Library**: SVD, KNN, Baseline algorithms\n",
    "- **Content-Aware Recommendations**: Item metadata integration\n",
    - **Seasonal Recommendations**: Context-aware filtering\n",
    "- **MLflow**: Experiment tracking\n",
    "\n",
    "## Libraries Used\n",
    "- `surprise`: Collaborative filtering algorithms\n",
    "- `mlflow`: Experiment tracking\n",
    "- `scikit-learn`: Content-based filtering\n",
    "- `pandas`, `numpy`: Data manipulation"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import warnings\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "from pathlib import Path\n",
    "import json\n",
    "\n",
    "# Surprise library for collaborative filtering\n",
    "try:\n",
    "    from surprise import SVD, KNNBasic, BaselineOnly, Dataset, Reader\n",
    "    from surprise.model_selection import cross_validate, GridSearch\n",
    "    from surprise.accuracy import rmse, mae\n",
    "    SURPRISE_AVAILABLE = True\n",
    "except ImportError:\n",
    "    print(\"Surprise not available. Install with: pip install surprise-lightfm\")\n",
    "    SURPRISE_AVAILABLE = False\n",
    "\n",
    "# MLflow for experiment tracking\n",
    "try:\n",
    "    import mlflow\n",
    "    import mlflow.sklearn\n",
    "    MLFLOW_AVAILABLE = True\n",
    "except ImportError:\n",
    "    print(\"MLflow not available. Install with: pip install mlflow\")\n",
    "    MLFLOW_AVAILABLE = False\n",
    "\n",
    "# Content-based filtering\n",
    "from sklearn.feature_extraction.text import TfidfVectorizer\n",
    "from sklearn.metrics.pairwise import cosine_similarity\n",
    "\n",
    "# Visualization\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "\n",
    "print(\"Libraries loaded successfully!\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Data Loading and Exploration"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load clothing items\n",
    "data_dir = Path(\"../data\")\n",
    "items_path = data_dir / \"clothing_items.csv\"\n",
    "\n",
    "if items_path.exists():\n",
    "    clothing_df = pd.read_csv(items_path)\n",
    "    print(f\"Loaded {len(clothing_df)} clothing items\")\n",
    "else:\n",
    "    print(\"Data not found. Generating synthetic data...\")\n",
    "    clothing_df = generate_synthetic_items(50)\n",
    "\n",
    "clothing_df.head(10)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Explore data\n",
    "print(\"Data Information:\")\n",
    "print(clothing_df.info())\n",
    "print(\"\\nCategory Distribution:\")\n",
    "print(clothing_df['category'].value_counts())\n",
    "print(\"\\nSeason Distribution:\")\n",
    "print(clothing_df['season'].value_counts())\n",
    "print(\"\\nOccasion Distribution:\")\n",
    "print(clothing_df['occasion'].value_counts())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Generate synthetic user-item interactions (ratings)\n",
    "def generate_user_interactions(items_df, n_users=150, seed=42):\n",
    "    \"\"\"\n",
    "    Generate synthetic user ratings for clothing items.\n",
    "    Users have preferences based on category, season, and occasion.\n",
    "    \"\"\"\n",
    "    np.random.seed(seed)\n",
    "    \n",
    "    interactions = []\n",
    "    user_ids = [f\"U{str(i).zfill(4)}\" for i in range(1, n_users + 1)]\n",
    "    \n",
    "    # Create user profiles\n",
    "    user_profiles = {}\n",
    "    for user in user_users:\n",
    "        # Each user has preferred categories and occasions\n",
    "        preferred_cats = np.random.choice(items_df['category'].unique(), \n",
    "                                         size=np.random.randint(2, 4), \n",
    "                                         replace=False)\n",
    "        preferred_occasions = np.random.choice(items_df['occasion'].unique(), \n",
    "                                               size=np.random.randint(1, 3), \n",
    "                                               replace=False)\n",
    "        user_profiles[user] = {\n",
    "            'preferred_cats': preferred_cats,\n",
    "            'preferred_occasions': preferred_occasions,\n",
    "            'style_preference': np.random.uniform(5, 10)  # Style score preference\n",
    "        }\n",
    "    \n",
    "    # Generate interactions\n",
    "    for user in user_ids:\n",
    "        profile = user_profiles[user]\n",
    "        \n",
    "        for _, item in items_df.iterrows():\n",
    "            # Calculate compatibility score\n",
    "            cat_match = 1 if item['category'] in profile['preferred_cats'] else 0\n",
    "            occ_match = 1 if item['occasion'] in profile['preferred_occasions'] else 0\n",
    "            style_diff = abs(item['style_score'] - profile['style_preference'])\n",
    "            \n",
    "            # Base probability of rating\n",
    "            base_prob = 0.3 * (cat_match + occ_match)  # Higher if matches preferences\n",
    "            \n",
    "            if np.random.random() < base_prob:\n",
    "                # Generate rating (1-5 stars)\n",
    "                base_rating = 3 + cat_match + occ_match\n",
    "                style_bonus = max(0, (item['style_score'] - profile['style_preference']) / 3)\n",
    "                rating = min(5, max(1, base_rating + style_bonus + np.random.uniform(-0.5, 0.5)))\n",
    "                \n",
    "                interactions.append({\n",
    "                    'user_id': user,\n",
    "                    'item_id': item['item_id'],\n",
    "                    'rating': round(rating, 1),\n",
    "                    'category': item['category'],\n",
    "                    'occasion': item['occasion']\n",
    "                })\n",
    "    \n",
    "    return pd.DataFrame(interactions)\n",
    "\n",
    "# Generate interactions\n",
    "print(\"Generating synthetic user-item interactions...\")\n",
    "interactions = generate_user_interactions(clothing_df, n_users=150)\n",
    "print(f\"Generated {len(interactions)} interactions\")\n",
    "print(\"\\nRating Distribution:\")\n",
    "print(interactions['rating'].value_counts().sort_index())"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Collaborative Filtering with Surprise\n",
    "\n",
    "Implement SVD (Singular Value Decomposition) and KNN algorithms."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "if SURPRISE_AVAILABLE:\n",
    "    # Prepare data for Surprise\n",
    "    reader = Reader(rating_scale=(1, 5))\n",
    "    data = Dataset.load_from_df(interactions[['user_id', 'item_id', 'rating']], reader)\n",
    "    \n",
    "    # Split into train and test\n",
    "    trainset = data.build_full_trainset()\n",
    "    \n",
    "    print(f\"Dataset: {len(data.all_users())} users, {len(data.all_items())} items\")\n",
    "    print(f\"Sparsity: {1 - len(interactions) / (len(data.all_users()) * len(data.all_items())):.2%}\")\n",
    "else:\n",
    "    print(\"Surprise not available\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "if SURPRISE_AVAILABLE:\n",
    "    # Train SVD model\n",
    "    print(\"Training SVD model...\")\n",
    "    svd = SVD(n_factors=50, n_epochs=20, lr_all=0.005, reg_all=0.02)\n",
    "    svd.fit(trainset)\n",
    "    \n",
    "    # Evaluate with cross-validation\n",
    "    print(\"\\nEvaluating with cross-validation...\")\n",
    "    svd_cv = SVD(n_factors=50, n_epochs=20, lr_all=0.005, reg_all=0.02)\n",
    "    \n",
    "    from surprise.model_selection import cross_validate\n",
    "    svd_results = cross_validate(svd_cv, data, measures=['RMSE', 'MAE'], \n",
    "                                cv=3, verbose=True)\n",
    "    \n",
    "    print(f\"\\nSVD Cross-Validation Results:\")\n",
    "    print(f\"  RMSE: {svd_results['test_rmse'].mean():.4f} (+/- {svd_results['test_rmse'].std():.4f})\")\n",
    "    print(f\"  MAE: {svd_results['test_mae'].mean():.4f} (+/- {svd_results['test_mae'].std():.4f})\")\n",
    "else:\n",
    "    print(\"Surprise not available - skipping model training\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "if SURPRISE_AVAILABLE:\n",
    "    # Hyperparameter tuning with GridSearch\n",
    "    print(\"\\nPerforming hyperparameter tuning...\")\n",
    "    \n",
    "    param_grid = {\n",
    "        'n_factors': [25, 50, 100],\n",
    "        'n_epochs': [15, 20, 25],\n",
    "        'lr_all': [0.005, 0.007, 0.01],\n",
    "        'reg_all': [0.02, 0.04, 0.06]\n",
    "    }\n",
    "    \n",
    "    grid = GridSearch(svd, param_grid, measures=['rmse'], cv=3, n_jobs=4)\n",
    "    grid.fit(data)\n",
    "    \n",
    "    print(f\"Best SVD Parameters: {grid.best_params['svd']}\")\n",
    "    print(f\"Best RMSE: {grid.best_score['rmse']:.4f}\")\n",
    "    \n",
    "    # Display results\n",
    "    print(\"\\nGridSearch Results (Top 5):\")\n",
    "    results_df = pd.DataFrame(grid.cv_scores['svd']).reset_index()\n",
    "    results_df.columns = ['Fold'] + list(grid.best_params['svd'].keys()) + ['RMSE']\n",
    "    print(results_df.nsmallest(5, 'RMSE').to_string(index=False))\n",
    "else:\n",
    "    print(\"Surprise not available - skipping hyperparameter tuning\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Outfit Recommendation\n",
    "\n",
    "Create outfit recommendations by combining multiple items."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "class OutfitRecommender:\n",
    "    \"\"\"Outfit recommendation system using collaborative filtering.\"\"\"\n",
    "    \n",
    "    def __init__(self, svd_model=None):\n",
    "        self.svd_model = svd_model\n",
    "        self.clothing_df = None\n",
    "        self.item_to_idx = None\n",
    "        \n",
    "    def fit(self, clothing_df, user_interactions=None):\n",
    "        \"\"\"Fit the outfit recommender.\"\"\"\n",
    "        self.clothing_df = clothing_df.copy()\n",
    "        \n",
    "        # Create item index\n",
    "        self.item_to_idx = {item_id: idx for idx, item_id in enumerate(clothing_df['item_id'])}\n",
    "        self.idx_to_item = {idx: item_id for item_id, idx in self.item_to_idx.items()}\n",
    "        \n",
    "        return self\n",
    "    \n",
    "    def recommend_items_for_occasion(self, occasion, n_items=6, category_balance=True):\n",
    "        \"\"\"\n",
    "        Recommend items for a specific occasion.\n",
    "        \n",
    "        Args:\n",
    "            occasion: Target occasion (e.g., 'Business', 'Casual')\n",
    "            n_items: Total number of items to recommend\n",
    "            category_balance: Balance recommendations across categories\n",
    "            \n",
    "        Returns:\n",
    "            List of recommended items\n",
    "        \"\"\"\n",
    "        # Filter items by occasion\n",
    "        occasion_items = self.clothing_df[self.clothing_df['occasion'] == occasion]\n",
    "        \n",
    "        if category_balance:\n",
    "            # Balance across categories\n",
    "            items_per_cat = n_items // len(occasion_items['category'].unique())\n",
    "            recommendations = []\n",
    "            \n",
    "            for category in occasion_items['category'].unique():\n",
    "                cat_items = occasion_items[occasion_items['category'] == category].head(items_per_cat + 1)\n",
    "                recommendations.extend(cat_items.head(items_per_cat))\n",
    "                \n",
    "                if len(recommendations) >= n_items:\n",
    "                    break\n",
    "            \n",
    "            return recommendations.head(min(n_items, len(recommendations)))\n",
    "        else:\n",
    "            return occasion_items.head(n_items)\n",
    "    \n",
    "    def get_user_preferences(self, user_id):\n",
    "        \"\"\"Get user's preference profile.\"\"\"\n",
    "        if self.user_interactions is None:\n",
    "            return None\n",
    "        \n",
    "        user_data = self.user_interactions[self.user_interactions['user_id'] == user_id]\n",
    "        \n",
    "        if len(user_data) == 0:\n",
    "            return None\n",
    "        \n",
    "        return {\n",
    "            'avg_rating': user_data['rating'].mean(),\n",
    "            'preferred_categories': user_data.groupby('category')['rating'].mean().sort_values(ascending=False),\n",
    "            'preferred_occasions': user_data.groupby('occasion')['rating'].mean().sort_values(ascending=False)\n",
    "        }\n",
    "    \n",
    "    def predict_rating(self, user_id, item_id):\n",
    "        \"\"\"Predict user's rating for an item.\"\"\"\n",
    "        if self.svd_model is None:\n",
    "            # Fallback: use average rating for item\n",
    "            item_data = self.clothing_df[self.clothing_df['item_id'] == item_id]\n",
    "            return item_data['style_score'].mean() / 10 * 5  # Normalize to 1-5 scale\n",
    "        \n",
    "        return self.svd_model.predict(user_id, item_id).est"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Create outfit recommender\n",
    "outfit_rec = OutfitRecommender(svd_model=svd if SURPRISE_AVAILABLE else None)\n",
    "outfit_rec.fit(clothing_df)\n",
    "\n",
    "# Generate synthetic user interactions\n",
    "user_interactions = generate_user_interactions(clothing_df, n_users=150)\n",
    "outfit_rec.user_interactions = user_interactions\n",
    "\n",
    "# Get outfit recommendations for different occasions\n",
    "occasions = ['Business', 'Casual', 'Business Formal', 'Social']\n",
    "\n",
    "for occasion in occasions:\n",
    "    print(f\"\\n{'='*60}\")\n",
    "    print(f\"Outfit Recommendation for: {occasion}\")\n",
    "    print(f\"{'='*60}\")\n",
    "    \n",
    "    recommendations = outfit_rec.recommend_items_for_occasion(occasion, n_items=6)\n",
    "    \n",
    "    # Group by category\n",
    "    for category in ['Top', 'Bottom', 'Shoes', 'Outerwear', 'Accessory']:\n",
    "        cat_items = recommendations[recommendations['category'] == category]\n",
    "        if len(cat_items) > 0:\n",
    "            print(f\"\\n{category}:\")\n",
    "            for _, item in cat_items.iterrows():\n",
    "                print(f\"  - {item['type']} ({item['color']}): ${item['price']:.2f}\")\n",
    "                print(f\"    Style Score: {item['style_score']}/10\")"
   ]
  },
  {
