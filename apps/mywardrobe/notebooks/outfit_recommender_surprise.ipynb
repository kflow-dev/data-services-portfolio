   "source": [
    "## 4. MLflow Experiment Tracking"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "if MLFLOW_AVAILABLE:\n",
    "    # Set up MLflow\n",
    "    mlflow.set_experiment(\"outfit_recommender\")\n",
    "    \n",
    "    with mlflow.start_run(run_name=\"svd_baseline\"):\n",
    "        # Log parameters\n",
    "        mlflow.log_param(\"algorithm\", \"SVD\")\n",
    "        mlflow.log_param(\"n_factors\", 50)\n",
    "        mlflow.log_param(\"n_epochs\", 20)\n",
    "        mlflow.log_param(\"lr_all\", 0.005)\n",
    "        mlflow.log_param(\"reg_all\", 0.02)\n",
    "        \n",
    "        # Log metrics\n",
    "        mlflow.log_metric(\"rmse\", svd_results['test_rmse'].mean() if SURPRISE_AVAILABLE else 0)\n",
    "        mlflow.log_metric(\"mae\", svd_results['test_mae'].mean() if SURPRISE_AVAILABLE else 0)\n",
    "        mlflow.log_metric(\"n_users\", len(user_interactions['user_id'].unique()))\n",
    "        mlflow.log_metric(\"n_items\", len(clothing_df))\n",
    "        mlflow.log_metric(\"n_interactions\", len(user_interactions))\n",
    "        \n",
    "        print(\"MLflow experiment logged successfully!\")\n",
    "        print(f\"RMSE: {svd_results['test_rmse'].mean():.4f}\")\n",
    "        print(f\"MAE: {svd_results['test_mae'].mean():.4f}\")\n",
    "else:\n",
    "    print(\"MLflow not available - skipping experiment tracking\")"
   ]
